<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_app" android:contentDescription="DubStudio logo" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DubStudio KH Pro" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/text" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MOBILE v1.2 · AI SUBTITLES · VOICE CLONE" style="@style/LabelMuted" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" android:text="Upload Video → Faster-Whisper → Khmer SUB → VoxCPM Voice"
            android:textColor="@color/muted" android:textSize="12sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:orientation="vertical" android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/LabelTitle" android:text="01 · Upload Video" android:layout_marginBottom="10dp" />
            <VideoView android:id="@+id/videoPreview" android:layout_width="match_parent"
                android:layout_height="195dp" android:background="@color/bg" />
            <TextView android:id="@+id/fileName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="No video selected" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="8dp" android:layout_marginBottom="10dp" />
            <Button android:id="@+id/chooseVideo" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/SecondaryButton" android:text="＋ Choose Video / ជ្រើសវីដេអូ" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:orientation="vertical" android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/LabelTitle" android:text="02 · AI Processing" android:layout_marginBottom="10dp" />
            <CheckBox android:id="@+id/scanSpeakers" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Scan Speakers / ស្វែងរកអ្នកនិយាយ" android:checked="true" android:textColor="@color/text" />
            <CheckBox android:id="@+id/isolateVocals" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Demucs: isolate dialogue from music (optional)" android:checked="false" android:textColor="@color/text" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/LabelMuted" android:text="Speaker Scan ត្រូវការ AI Backend បន្ថែម។ វាសម្គាល់អ្នកនិយាយពីសំឡេង មិនអាចប្រាប់ឈ្មោះតួអង្គពិត ឬភេទដោយប្រាកដបានទេ។"
                android:layout_marginBottom="10dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/LabelMuted"
                android:text="Backend URL (HTTPS)" android:layout_marginBottom="4dp" />
            <EditText android:id="@+id/backendUrl" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="https://your-server.example.com" android:inputType="textUri" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/LabelMuted"
                android:text="API Token" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
            <EditText android:id="@+id/apiToken" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Secret token" android:inputType="textPassword" />
            <Button android:id="@+id/checkServer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" style="@style/SecondaryButton"
                android:text="✓ Check AI Server / ពិនិត្យការភ្ជាប់" />
            <TextView android:id="@+id/serverStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/LabelMuted" android:layout_marginTop="8dp"
                android:text="AI Server: Not connected. Check Server before processing. Faster-Whisper, Demucs and VoxCPM2 run in the cloud, not on this phone." />
            <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" style="@style/PrimaryButton" android:text="✦ Generate Khmer Subtitles" />
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="12dp" android:max="100"
                android:progress="0" android:progressTint="@color/accent" />
            <TextView android:id="@+id/progressText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="0% · Ready" android:textSize="14sp" android:textColor="@color/text" />
            <Button android:id="@+id/resumeKhmer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" style="@style/SecondaryButton"
                android:text="↻ Resume Khmer Translation" android:enabled="false" />
            <TextView android:id="@+id/scanStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/LabelMuted" android:layout_marginTop="7dp" android:text="Scan Character — Waiting" />
            <TextView android:id="@+id/originalStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/LabelMuted" android:layout_marginTop="3dp" android:text="Original SUB — Waiting" />
            <TextView android:id="@+id/khmerStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/LabelMuted" android:layout_marginTop="3dp" android:text="Translation + Khmer SRT — Waiting" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:orientation="vertical" android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/LabelTitle" android:text="03 · Subtitle Results" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/subtitlePreview" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/input_bg" android:padding="12dp" android:textColor="@color/text" android:textSize="14sp"
                android:minHeight="120dp" android:text="Original និង Khmer Subtitle នឹងបង្ហាញនៅទីនេះ។" />
            <Button android:id="@+id/renameSpeakers" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/SecondaryButton" android:text="Edit Speaker Names" android:layout_marginTop="10dp" android:enabled="false" />
            <Button android:id="@+id/saveOriginal" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/SecondaryButton" android:text="↓ Save Original SRT" android:layout_marginTop="7dp" android:enabled="false" />
            <Button android:id="@+id/saveKhmer" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/PrimaryButton" android:text="↓ Save Khmer SRT" android:layout_marginTop="7dp" android:enabled="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:orientation="vertical" android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/LabelTitle" android:text="04 · VoxCPM2 AI Voice / Clone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/LabelMuted" android:layout_marginTop="6dp"
                android:text="Optional cloud AI voice. For cloning, select a speaker and use only a recording you own or have permission to use." />
            <CheckBox android:id="@+id/voiceConsent" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="I have permission from the voice owner" android:textColor="@color/text" />
            <Button android:id="@+id/selectVoiceRef" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/SecondaryButton" android:text="＋ Choose reference recording (optional)"
                android:layout_marginTop="7dp" />
            <TextView android:id="@+id/voiceStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/LabelMuted" android:text="VoxCPM2 not started" android:layout_marginTop="5dp" />
            <Button android:id="@+id/voiceStyles" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/SecondaryButton" android:text="Set AI Voice Style per Speaker"
                android:layout_marginTop="7dp" />
            <Button android:id="@+id/generateVoice" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/PrimaryButton" android:text="✦ Generate AI Voice WAV" android:layout_marginTop="9dp" />
            <Button android:id="@+id/listenVoice" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/SecondaryButton" android:text="▶ Listen AI Voice" android:layout_marginTop="6dp" />
            <Button android:id="@+id/saveVoice" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/SecondaryButton" android:text="↓ Save AI Voice WAV" android:layout_marginTop="6dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            android:gravity="center" android:textColor="@color/muted" android:textSize="11sp"
            android:text="Generated subtitles require review. Uploaded video is processed on your configured AI server." />
    </LinearLayout>
</ScrollView>
