# Use a random secret for your API; never commit it to a public repository.
DUBSTUDIO_API_TOKEN=replace-me-with-long-random-secret
DUBSTUDIO_DATA_DIR=./data
MAX_VIDEO_MB=300
JOB_RETENTION_HOURS=24
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b
# Speaker diarization requires pyannote.audio and accepted access to the model.
WITH_DIARIZATION=0
ENABLE_DIARIZATION=0
HF_TOKEN=

# Enable only after installing models and dependencies on a capable AI backend.
ENABLE_DEMUCS=0
ENABLE_VOXCPM=0
VOXCPM_MODEL=openbmb/VoxCPM2
